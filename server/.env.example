# Comma-separated browser origins allowed to make credentialed requests.
ORIGINS=http://localhost:5173,https://builder-ai-lyart.vercel.app

# Set to production on the deployed server. "none" allows the auth cookie to
# accompany requests from a separately hosted frontend; HTTPS is required.
NODE_ENV=production
COOKIE_SAME_SITE=none

MONGODB_URI=
JWT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
